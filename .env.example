# Required for persistent state/logs (create a free Upstash Redis database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protect scheduled tick endpoint and manual kill-switch endpoint
CRON_SECRET=replace-with-long-random-secret
ADMIN_SECRET=replace-with-a-different-long-random-secret

# Optional safety override; Redis key indodax:kill_switch can also be toggled via /api/control
KILL_SWITCH=false
